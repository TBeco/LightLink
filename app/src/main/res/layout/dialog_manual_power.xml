<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:orientation="vertical"

    android:paddingStart="24dp"
    android:paddingTop="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="20dp"

    android:background="@drawable/dialog_manual_background">


    <!--
        팝업 제목

        언어별 문자열 리소스를 사용한다.

        접근성 Heading으로 지정하여
        TalkBack 사용자가 팝업의 제목을
        쉽게 구분할 수 있도록 한다.

        accessibilityHeading은 Android 9(API 28)
        이상에서 지원된다.
    -->
    <TextView
        android:id="@+id/textManualPowerTitle"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:text="@string/manual_power_title"

        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"

        android:accessibilityHeading="true"
        tools:ignore="UnusedAttribute"/>


    <!--
        수동 전원 제어 안내

        현재 전원 상태를 읽을 수 없는 이유와
        사용자가 Wake / Sleep 명령을 직접
        선택해야 한다는 내용을 표시한다.

        안내 문구는 시스템 언어에 맞게 변경된다.

        일반 TextView이므로 TalkBack에서도
        별도의 contentDescription 없이 읽을 수 있다.
    -->
    <TextView
        android:id="@+id/textManualPowerMessage"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginTop="18dp"

        android:text="@string/manual_power_message"

        android:textColor="#BDBDBD"
        android:textSize="15sp"

        android:lineSpacingExtra="3dp" />


    <!--
        하단 버튼 영역

        기존의 가로 배치 방식을 유지한다.

        작은 화면이나 글자 크기가 커진 환경에서
        버튼이 지나치게 좁아지지 않도록
        Sleep 버튼 앞의 간격을 조정한다.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginTop="24dp"

        android:orientation="horizontal">


        <!--
            취소 버튼

            현재 팝업만 닫으며 전원 명령을 보내지 않는다.

            버튼 자체에 텍스트가 있으므로
            별도의 contentDescription은 추가하지 않는다.

            버튼의 텍스트가 TalkBack에서도 사용된다.
        -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/buttonManualCancel"

            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="0.8"

            android:minWidth="0dp"
            android:minHeight="0dp"

            android:background="@drawable/dialog_action_button_background"
            android:backgroundTint="@null"

            android:text="@string/manual_power_cancel"
            android:textAllCaps="false"
            android:textColor="#FF6B6B"
            android:textSize="15sp" />


        <!--
            Sleep 명령 버튼

            실제 장치의 현재 상태를 확인할 수 없으므로
            Sleep 명령을 수동으로 전송하는 기능이다.

            버튼 이름은 모든 언어에서 Sleep으로 유지한다.

            TalkBack에서는 언어별 설명을 사용하여
            명령 전송 버튼이라는 점을 명확하게 안내한다.
        -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/buttonManualSleep"

            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"

            android:layout_marginStart="50dp"

            android:minWidth="0dp"
            android:minHeight="0dp"

            android:background="@drawable/dialog_action_button_background"
            android:backgroundTint="@null"

            android:text="@string/manual_power_sleep"
            android:contentDescription="@string/manual_power_sleep_accessibility"

            android:textAllCaps="false"
            android:textColor="#7EAEFF"
            android:textSize="15sp" />


        <!--
            Wake 명령 버튼

            실제 장치의 현재 상태를 확인할 수 없으므로
            Wake 명령을 수동으로 전송하는 기능이다.

            버튼 이름은 모든 언어에서 Wake로 유지한다.

            TalkBack에서는 언어별 설명을 제공한다.
        -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/buttonManualWake"

            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"

            android:layout_marginStart="8dp"

            android:minWidth="0dp"
            android:minHeight="0dp"

            android:background="@drawable/dialog_action_button_background"
            android:backgroundTint="@null"

            android:text="@string/manual_power_wake"
            android:contentDescription="@string/manual_power_wake_accessibility"

            android:textAllCaps="false"
            android:textColor="#6FD67A"
            android:textSize="15sp" />

    </LinearLayout>

</LinearLayout>