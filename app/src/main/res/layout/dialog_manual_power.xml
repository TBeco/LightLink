<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:orientation="vertical"

    android:paddingStart="24dp"
    android:paddingTop="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="20dp"

    android:background="@drawable/dialog_manual_power_background">


    <!--
        팝업 제목
    -->
    <TextView
        android:id="@+id/textManualPowerTitle"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:text="수동 전원 제어 필요"

        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold" />


    <!--
        현재 상태를 읽을 수 없는 이유와
        수동 선택이 필요하다는 안내
    -->
    <TextView
        android:id="@+id/textManualPowerMessage"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginTop="18dp"

        android:text="이 Base Station은 현재 전원 상태를 확인할 수 없습니다.\n\n일부 이전 버전의 Base Station 펌웨어에서 발생할 수 있습니다.\n\n원하는 전원 상태를 직접 선택해주세요."

        android:textColor="#BDBDBD"
        android:textSize="15sp"

        android:lineSpacingExtra="3dp" />


    <!--
        하단 버튼 영역
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginTop="24dp"

        android:orientation="horizontal">


        <!-- 취소 -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/buttonManualCancel"

            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="0.8"

            android:minWidth="0dp"
            android:minHeight="0dp"

            android:background="@drawable/dialog_action_button_background"
            android:backgroundTint="@null"

            android:text="취소"
            android:textAllCaps="false"
            android:textColor="#FF6B6B"
            android:textSize="15sp" />


        <!-- Sleep -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/buttonManualSleep"

            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"

            android:layout_marginStart="50dp"

            android:minWidth="0dp"
            android:minHeight="0dp"

            android:background="@drawable/dialog_action_button_background"
            android:backgroundTint="@null"

            android:text="Sleep"
            android:textAllCaps="false"
            android:textColor="#7EAEFF"
            android:textSize="15sp" />


        <!-- Wake -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/buttonManualWake"

            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"

            android:layout_marginStart="8dp"

            android:minWidth="0dp"
            android:minHeight="0dp"

            android:background="@drawable/dialog_action_button_background"
            android:backgroundTint="@null"

            android:text="Wake"
            android:textAllCaps="false"
            android:textColor="#6FD67A"
            android:textSize="15sp" />

    </LinearLayout>

</LinearLayout>