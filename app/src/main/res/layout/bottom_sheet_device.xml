<?xml version="1.0" encoding="utf-8"?>

<!--
    Base Station 장치 관리 Bottom Sheet.
    좁은 화면과 글꼴 확대 환경에서도 내용을 볼 수 있도록 스크롤을 지원한다.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="@drawable/bg_device_sheet">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">

        <!-- 상단 손잡이: 장식 요소이므로 접근성 탐색에서 제외한다. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="━━━"
            android:textColor="#777777"
            android:textSize="18sp"
            android:importantForAccessibility="no"
            tools:ignore="HardcodedText" />

        <!-- 장치 이름, 부제목, 닫기 버튼 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- 장치 이름은 MainActivity에서 설정한다. -->
                <TextView
                    android:id="@+id/textSheetDeviceName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:accessibilityHeading="true"
                    tools:ignore="UnusedAttribute"
                    tools:text="LHB-94A66C14" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/device_sheet_subtitle"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- 아이콘 버튼에 접근성 설명을 제공하며, 48dp 터치 영역을 유지한다. -->
            <ImageButton
                android:id="@+id/buttonSheetClose"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/device_sheet_close"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="#AAAAAA" />

        </LinearLayout>

        <!-- 장치 정보 / 식별 기능 구분선 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="#444444" />

        <!-- 장치 식별 영역 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/device_identify_title"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:accessibilityHeading="true"
            tools:ignore="UnusedAttribute" />

        <!-- 식별 버튼 실행 시 동작을 설명하는 일반 안내 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/device_identify_description"
            android:textColor="#BDBDBD"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp" />

        <!--
            Identify 기본 주의사항.

            모든 Base Station에 공통으로 표시한다.
            펌웨어에 따라 Sleep 상태에서 Identify를 실행하면
            장치가 깨어날 수 있음을 안내한다.

            안내 기호와 본문을 분리하여
            글꼴 확대나 좁은 화면에서 줄바꿈이 발생해도
            본문 시작 위치를 일정하게 유지한다.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="top">

            <!--
                안내 기호.

                시각적 장식이므로 TalkBack 탐색에서 제외한다.
            -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="※"
                android:textColor="@color/warning_text_color"
                android:textSize="12sp"

                android:importantForAccessibility="no"
                tools:ignore="HardcodedText" />

            <!--
                Identify 기본 안내 문구.

                기존 View ID를 유지한다.
            -->
            <TextView
                android:id="@+id/textIdentifyWarning"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"

                android:text="@string/identify_warning_default"
                android:textColor="@color/warning_text_color"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp" />

        </LinearLayout>

        <!--
            Power State READ 미지원 장치 전용 안내.

            현재 상태를 읽을 수 없지만
            수동 전원 제어가 가능한 장치에만 표시한다.

            기본적으로 안내 영역 전체를 숨기며,
            MainActivity의 refreshIdentifyButton()에서
            장치 상태에 따라 표시 여부를 변경한다.

            안내 기호와 본문을 함께 숨기기 위해
            부모 LinearLayout에 별도의 ID를 부여한다.
        -->
        <LinearLayout
            android:id="@+id/layoutIdentifyWarningUnsupported"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="top"

            android:visibility="gone">

            <!--
                안내 기호.

                부모 레이아웃과 함께 표시되거나 숨겨진다.
                접근성 서비스에서는 본문만 읽도록 한다.
            -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="※"
                android:textColor="@color/warning_text_color"
                android:textSize="12sp"

                android:importantForAccessibility="no"
                tools:ignore="HardcodedText" />

            <!--
                Power State READ 미지원 안내 문구.

                기존 View ID는 유지하며,
                표시 여부는 부모 LinearLayout에서 관리한다.
            -->
            <TextView
                android:id="@+id/textIdentifyWarningUnsupported"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"

                android:text="@string/identify_warning_read_unsupported"
                android:textColor="@color/warning_text_color"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp" />

        </LinearLayout>

        <!-- 기존 식별 버튼: 활성화 여부는 MainActivity에서 관리한다. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonIdentify"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:minWidth="196dp"
            android:text="@string/device_identify_button"
            android:contentDescription="@string/device_identify_button_description"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textColor="#FFFFFF"
            app:backgroundTint="#4285F4"
            app:cornerRadius="10dp" />

        <!-- 식별 기능 / RF 채널 관리 구분선 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:background="#444444" />

        <!--
            RF 채널 관리 영역 (Base Station 2.0).
            채널 조회 및 중복 상태는 MainActivity에서 연결하며,
            채널 1~16의 4×4 선택 UI는 별도의 다이얼로그에서 제공한다.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical">

            <!-- 영역 제목 및 전원 상태 (Awake/Sleep 문자열은 기존 상태 표현 사용) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/device_channel_title"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:accessibilityHeading="true"
                    tools:ignore="UnusedAttribute" />

                <!-- 실제 상태를 읽어 확인했을 때 MainActivity에서 표시한다. -->
                <TextView
                    android:id="@+id/textSheetChannelState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="#A5C4FF"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:text="Awake"
                    tools:visibility="visible" />

            </LinearLayout>

            <!-- 현재 채널 카드: 채널 미확인 시 '—' 표시, 중복 안내는 기본 숨김 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:padding="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_sheet_channel_info">

                <TextView
                    android:id="@+id/textSheetCurrentChannel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/device_channel_current_placeholder"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="현재 채널 3" />

                <!-- 기존 RfChannelConflictChecker에서 중복 확인 시 표시한다. -->
                <TextView
                    android:id="@+id/textSheetChannelConflict"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/device_channel_conflict"
                    android:textColor="@color/warning_text_color"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:visibility="visible" />

            </LinearLayout>

            <!-- 회색 설명: 주의사항이 아니라 '채널 변경' 버튼의 기능을 안내한다. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/device_channel_description"
                android:textColor="#BDBDBD"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp" />

            <!--
                채널 변경 버튼: 식별 버튼과 크기 및 모서리 디자인을 통일한다.
                현재는 UI 단계이므로 비활성화하며, 추후 Awake 여부와 지원 여부를
                확인한 뒤 4×4 선택 다이얼로그에 연결한다.
            -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonSheetChangeChannel"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:minWidth="196dp"
                android:text="@string/device_channel_change_button"
                android:contentDescription="@string/device_channel_change_description"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:enabled="false"
                app:backgroundTint="#4285F4"
                app:cornerRadius="10dp" />

            <!--
                RF 채널 사용 주의사항.

                안내 기호와 본문을 분리하여
                문장이 여러 줄로 표시되더라도
                본문 시작 위치에 맞춰 정렬한다.
            -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="top">

                <!-- 안내 기호 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="※"
                    android:textColor="@color/warning_text_color"
                    android:textSize="12sp"
                    android:importantForAccessibility="no"
                    tools:ignore="HardcodedText" />

                <!-- RF 채널 사용 안내 -->
                <TextView
                    android:id="@+id/textSheetChannelUsageWarning"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"

                    android:text="@string/device_channel_usage_warning"
                    android:textColor="@color/warning_text_color"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp" />

            </LinearLayout>

            <!--
                RF 채널 변경 조건 안내.

                첫 번째 안내와 동일한 내어쓰기 구조를 사용한다.
                향후 실제 장치 상태에 따라 표시 여부를 관리할 수 있다.
            -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="top">

                <!-- 안내 기호 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="※"
                    android:textColor="@color/warning_text_color"
                    android:textSize="12sp"
                    android:importantForAccessibility="no"
                    tools:ignore="HardcodedText" />

                <!-- 채널 변경 조건 안내 -->
                <TextView
                    android:id="@+id/textSheetChannelChangeHint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"

                    android:text="@string/device_channel_power_warning"
                    android:textColor="@color/warning_text_color"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>