<?xml version="1.0" encoding="utf-8"?>

<!--
    장치 관리 Bottom Sheet.

    좁은 화면이나 글꼴 확대 환경에서도
    모든 기능에 접근할 수 있도록
    세로 스크롤을 지원한다.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"

    android:background="@drawable/bg_device_sheet">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"

        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">


    <!--
        Bottom Sheet 상단 손잡이

        실제로 조작하는 버튼이 아닌 장식 요소이므로
        접근성 서비스에서 읽지 않도록 제외한다.

        "━━━"는 번역할 필요가 없는 시각적 장식이다.
    -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"

        android:text="━━━"
        android:textColor="#777777"
        android:textSize="18sp"

        android:importantForAccessibility="no"

        tools:ignore="HardcodedText" />


    <!--
        장치 이름 및 닫기 버튼
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp">


        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">


            <!--
                Base Station 이름

                실제 장치 이름은 MainActivity에서 설정한다.

                tools:text는 Android Studio Preview에서만
                표시되므로 실제 앱에는 영향을 주지 않는다.

                Android 9 이상에서는 접근성 제목으로 인식된다.
            -->
            <TextView
                android:id="@+id/textSheetDeviceName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"

                android:accessibilityHeading="true"
                tools:ignore="UnusedAttribute"

                tools:text="LHB-94A66C14" />


            <!--
                장치 관리 부제목

                언어별 문자열 리소스를 사용한다.
            -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"

                android:text="@string/device_sheet_subtitle"
                android:textColor="#AAAAAA"
                android:textSize="12sp" />

        </LinearLayout>


        <!--
            장치 관리 화면 닫기

            아이콘만 있는 버튼이므로
            TalkBack에서 버튼의 용도를 알 수 있도록
            접근성 설명을 제공한다.

            48dp 터치 영역은 그대로 유지한다.
        -->
        <ImageButton
            android:id="@+id/buttonSheetClose"
            android:layout_width="48dp"
            android:layout_height="48dp"

            android:background="?attr/selectableItemBackgroundBorderless"

            android:contentDescription="@string/device_sheet_close"

            android:src="@android:drawable/ic_menu_close_clear_cancel"

            app:tint="#AAAAAA" />

    </LinearLayout>


    <!--
        장치 정보와 식별 영역을 구분하는 선
    -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="20dp"

        android:background="#444444" />


    <!--
        장치 식별 영역 제목

        접근성 제목(Heading)으로 지정하여
        TalkBack 사용자가 화면 구조를 파악하기 쉽게 한다.
    -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"

        android:text="@string/device_identify_title"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"

        android:accessibilityHeading="true"
        tools:ignore="UnusedAttribute" />


    <!--
        장치 식별 기능 설명

        실제 설치된 베이스스테이션을 구분하기 위해
        LED를 흰색으로 점멸시키는 기능이다.

        설명 문구는 시스템 언어에 맞게 표시한다.
    -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"

        android:text="@string/device_identify_description"
        android:textColor="#BDBDBD"
        android:textSize="14sp"
        android:lineSpacingExtra="3dp" />


    <!--
        기본 식별 안내

        모든 베이스스테이션에 공통으로 표시한다.

        펌웨어에 따라 Sleep 상태에서 Identify를 실행하면
        장치가 깨어날 수 있음을 안내한다.
    -->
    <TextView
        android:id="@+id/textIdentifyWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"

        android:text="@string/identify_warning_default"
        android:textColor="@color/warning_text_color"
        android:textSize="12sp"
        android:lineSpacingExtra="2dp" />


    <!--
        Power State READ 미지원 장치 전용 안내

        전원 상태를 읽을 수 없지만
        수동 전원 제어가 가능한 장치에서만 표시한다.

        기본적으로 GONE 상태이며,
        MainActivity에서 장치 정보에 따라
        표시 여부를 변경한다.

        GONE 상태에서는 레이아웃 공간을 차지하지 않으며,
        접근성 서비스에서도 읽지 않는다.
    -->
    <TextView
        android:id="@+id/textIdentifyWarningUnsupported"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"

        android:text="@string/identify_warning_read_unsupported"
        android:textColor="#E6B96A"
        android:textSize="12sp"
        android:lineSpacingExtra="2dp"

        android:visibility="gone" />


    <!--
        장치 식별 버튼

        버튼에 표시되는 문구는 다국어 리소스를 사용한다.

        TalkBack에서는 버튼의 목적을 조금 더
        구체적으로 안내하도록 별도의
        contentDescription을 제공한다.

        버튼 활성화 여부는 기존 MainActivity의
        refreshIdentifyButton()에서 관리한다.
    -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonIdentify"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"

        android:minWidth="196dp"

        android:text="@string/device_identify_button"
        android:contentDescription="@string/device_identify_button_description"

        android:textAllCaps="false"
        android:textSize="15sp"
        android:textColor="#FFFFFF"

        app:backgroundTint="#4285F4"
        app:cornerRadius="10dp" />


    <!--
        장치 식별 영역과 향후 기능 안내를 구분하는 선
    -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="24dp"

        android:background="#444444" />


        <!--
            RF 채널 관리 영역.

            Base Station 2.0의 현재 RF 채널과
            채널 중복 여부를 표시한다.

            실제 채널 정보 및 Awake/Sleep 상태는
            MainActivity에서 연결할 예정이다.

            채널 1~16을 선택하는 4×4 배열은
            별도의 다이얼로그에 구현한다.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical">

            <!--
                RF 채널 관리 제목 및 전원 상태.

                상태 정보는 실제로 확인된 경우에만 표시한다.
            -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"

                    android:text="@string/device_channel_title"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"

                    android:accessibilityHeading="true"
                    tools:ignore="UnusedAttribute" />

                <!--
                    현재 전원 상태 표시.

                    Awake / Sleep 등의 내부 상태 문자열은
                    기존 LightLink의 상태 표현을 사용한다.
                -->
                <TextView
                    android:id="@+id/textSheetChannelState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"

                    android:textColor="#A5C4FF"
                    android:textSize="12sp"

                    android:visibility="gone"

                    tools:text="Awake"
                    tools:visibility="visible" />

            </LinearLayout>


            <!--
                현재 RF 채널 및 중복 경고 표시.

                채널 정보가 없는 경우에는
                기본적으로 — 문자를 표시한다.

                실제 채널과 중복 여부는
                MainActivity에서 갱신한다.
            -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"

                android:padding="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"

                android:background="@drawable/bg_sheet_channel_info">

                <!-- 현재 채널 -->
                <TextView
                    android:id="@+id/textSheetCurrentChannel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"

                    android:text="@string/device_channel_current_placeholder"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"

                    tools:text="현재 채널 3" />

                <!--
                    RF 채널 중복 경고.

                    기존 RfChannelConflictChecker를 통해
                    중복이 확인된 경우에만 표시한다.
                -->
                <TextView
                    android:id="@+id/textSheetChannelConflict"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"

                    android:text="@string/device_channel_conflict"
                    android:textColor="@color/warning_text_color"
                    android:textSize="12sp"

                    android:visibility="gone"
                    tools:visibility="visible" />

            </LinearLayout>


            <!--
                RF 채널 안내 문구.

                글꼴 확대 및 좁은 화면에서도
                문장이 잘리지 않도록 줄바꿈을 허용한다.
            -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"

                android:text="@string/device_channel_description"
                android:textColor="#BDBDBD"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp" />


            <!--
                RF 채널 변경 버튼.

                현재는 UI만 구현하는 단계이므로
                기본적으로 비활성화한다.

                이후 MainActivity에서 다음 조건을 확인한다.

                1. Base Station 2.0 장치
                2. Awake 상태 확인
                3. 채널 변경 기능 사용 가능 여부

                조건을 충족하면 버튼을 활성화하고
                4×4 채널 선택 다이얼로그를 표시한다.
            -->
            <!--
                RF 채널 변경 버튼.

                기존 식별하기 버튼과 동일한 크기와
                둥근 모서리 디자인을 사용한다.

                실제 채널 변경 기능은 추후 연결한다.
            -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonSheetChangeChannel"

                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"

                android:minWidth="196dp"

                android:text="@string/device_channel_change_button"
                android:contentDescription="@string/device_channel_change_description"

                android:textAllCaps="false"
                android:textSize="15sp"
                android:textColor="#FFFFFF"

                android:enabled="false"

                app:backgroundTint="#4285F4"
                app:cornerRadius="10dp" />


            <!--
                채널 변경 제한 안내.

                Sleep 또는 상태를 확인할 수 없는 경우에
                사용자에게 안내하기 위한 텍스트.

                실제 표시 여부는 MainActivity에서 관리한다.
            -->
            <TextView
                android:id="@+id/textSheetChannelChangeHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"

                android:text="@string/device_channel_awake_required"
                android:textColor="@color/warning_text_color"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp"

                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>