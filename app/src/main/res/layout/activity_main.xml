<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    tools:context=".MainActivity">


    <!--
        상단 메뉴 버튼

        48dp 터치 영역 안에
        24dp 메뉴 아이콘을 표시한다.
    -->
    <ImageButton
        android:id="@+id/buttonMenu"
        android:layout_width="48dp"
        android:layout_height="48dp"

        android:padding="12dp"

        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/menu_open"

        app:srcCompat="@drawable/ic_menu"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <!--
        앱 이름
    -->
    <TextView
        android:id="@+id/textTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:text="@string/app_name"
        android:textColor="@color/white"
        android:textSize="30sp"
        android:textStyle="bold"

        android:layout_marginStart="10dp"

        app:layout_constraintStart_toEndOf="@id/buttonMenu"
        app:layout_constraintTop_toTopOf="@id/buttonMenu"
        app:layout_constraintBottom_toBottomOf="@id/buttonMenu" />


    <!--
        상단 영역과 Base Station 목록을 구분하는 선
    -->
    <View
        android:id="@+id/topDivider"
        android:layout_width="0dp"
        android:layout_height="2dp"

        android:background="#1E1C20"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/buttonMenu" />


    <!--
        현재 LightLink 앱 버전

        실제 버전 문자열은 MainActivity에서
        BuildConfig.VERSION_NAME을 읽어 표시한다.

        tools:text는 Android Studio Preview에서만 표시된다.
    -->
    <TextView
        android:id="@+id/textAppVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"

        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topDivider"

        tools:text="v0.9.0-beta.1" />


    <!--
        검색된 Base Station 목록

        아래쪽에는 최근 검색 시간을 표시하므로
        RecyclerView의 Bottom을 textLastScan 위쪽에 연결한다.
    -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerBaseStations"
        android:layout_width="0dp"
        android:layout_height="0dp"

        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textAppVersion"
        app:layout_constraintBottom_toTopOf="@id/textLastScan"

        tools:listitem="@layout/item_ble_device" />


    <!--
        Base Station이 하나도 없을 때 표시할 안내 문구

        RecyclerView 영역의 가운데에 표시한다.

        RecyclerView보다 좌우 16dp씩 좁게 배치하여
        긴 안내 문구가 화면 밖으로 벗어나지 않도록 한다.

        텍스트가 길어지면 자동으로 줄바꿈한다.
    -->
    <TextView
        android:id="@+id/textEmpty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"

        android:gravity="center"
        android:textAlignment="center"

        android:text="@string/empty_scan_prompt"
        android:textColor="#AAAAAA"
        android:textSize="15sp"

        app:layout_constraintStart_toStartOf="@id/recyclerBaseStations"
        app:layout_constraintEnd_toEndOf="@id/recyclerBaseStations"
        app:layout_constraintTop_toTopOf="@id/recyclerBaseStations"
        app:layout_constraintBottom_toBottomOf="@id/recyclerBaseStations" />


    <!--
        마지막으로 BLE 검색을 수행한 시간

        실제 앱 시작 직후에는 "-"를 표시하고,
        검색이 완료되면 MainActivity에서 시간을 갱신한다.

        tools:text는 Android Studio Preview에서만 표시된다.
    -->
    <TextView
        android:id="@+id/textLastScan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:text="@string/last_scan_placeholder"
        android:textColor="#777777"
        android:textSize="12sp"

        android:layout_marginEnd="24dp"
        android:layout_marginBottom="10dp"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/buttonScan"

        tools:text="최근 검색 | 2026-10-08 15:32:14" />


    <!--
    RF 채널 중복 경고 안내 영역

    검색 버튼 왼쪽에 배치한다.

    동일한 RF 채널을 사용하는 Base Station이
    2대 이상 발견되면 경고 문구를 표시한다.

    첫 번째 줄:
    채널 중복 경고 제목.

    두 번째 줄:
    중복된 RF 채널 번호와 장치 수.

    기본 상태에서는 GONE으로 숨긴다.

    실제 표시 여부와 안내 문구는
    MainActivity에서 갱신한다.

    tools:visibility와 tools:text는
    Android Studio Preview에서만 적용된다.
-->
    <LinearLayout
        android:id="@+id/layoutChannelConflictWarning"
        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:layout_marginStart="16dp"
        android:layout_marginEnd="12dp"

        android:orientation="vertical"
        android:gravity="center_vertical"

        android:visibility="gone"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/buttonScan"
        app:layout_constraintTop_toTopOf="@id/buttonScan"
        app:layout_constraintBottom_toBottomOf="@id/buttonScan"

        tools:visibility="visible">


        <!--
            RF 채널 중복 경고 제목.

            언어별 문자열 리소스를 사용하며,
            경고가 표시될 때 항상 동일한 제목을 사용한다.
        -->
        <TextView
            android:id="@+id/textChannelConflictTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:gravity="end"

            android:text="@string/channel_conflict_title"
            android:textColor="#FFB74D"
            android:textSize="13sp"
            android:textStyle="bold" />


        <!--
            중복된 RF 채널의 상세 정보.

            실제 텍스트는 MainActivity에서
            현재 중복 상태에 따라 설정한다.

            tools:text는 Android Studio Preview에서만 표시된다.
        -->
        <TextView
            android:id="@+id/textChannelConflictDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="2dp"

            android:gravity="end"

            android:textColor="#AAAAAA"
            android:textSize="12sp"

            tools:text="채널 3 · 2대" />

    </LinearLayout>


    <!--
        Base Station 검색 버튼

        화면 오른쪽 아래에 배치한다.

        검색 중에는 Search 아이콘 대신
        Stop 아이콘으로 변경된다.
    -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonScan"
        android:layout_width="80dp"
        android:layout_height="80dp"

        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"

        android:enabled="true"
        android:contentDescription="@string/scan_search"

        app:icon="@drawable/ic_search"
        app:iconSize="40dp"
        app:iconPadding="0dp"
        app:iconGravity="textStart"
        app:iconTint="@null"

        app:backgroundTint="@color/button_background_color"
        app:cornerRadius="15dp"
        app:rippleColor="#616161"

        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>