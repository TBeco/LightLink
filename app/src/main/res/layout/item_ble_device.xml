<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:orientation="horizontal"
    android:padding="12dp">


    <!--
        왼쪽: Base Station 정보

        장치 이름
        현재 전원 상태
        MAC 주소 / RSSI
        마지막 상태 확인 시간
    -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:layout_weight="1"
        android:orientation="vertical">


        <!-- Base Station 이름 -->
        <TextView
            android:id="@+id/textDeviceName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"

            tools:text="LHB-XXXX" />


        <!-- 현재 Base Station 전원 상태 -->
        <TextView
            android:id="@+id/textDeviceStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="4dp"

            android:textColor="#AAAAAA"
            android:textSize="14sp"

            tools:text="Awake" />


        <!-- MAC 주소와 RSSI -->
        <TextView
            android:id="@+id/textDeviceInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="4dp"

            android:textColor="#777777"
            android:textSize="12sp"

            tools:text="XX:XX:XX:XX:XX:XX  •  -52 dBm" />


        <!--
            실제 Power State를 마지막으로
            정상 확인한 시간을 표시한다.

            상태 확인에 실패한 경우에는
            이 시간을 갱신하지 않는다.
        -->
        <TextView
            android:id="@+id/textLastStateChecked"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="4dp"

            android:textColor="#777777"
            android:textSize="12sp"

            tools:text="마지막 상태 확인 | 2026-10-08 15:35:18" />

    </LinearLayout>


    <!--
        오른쪽: Base Station 전원 버튼

        왼쪽 정보 영역 전체를 기준으로
        세로 가운데에 배치한다.
    -->
    <ImageButton
        android:id="@+id/buttonPower"
        android:layout_width="56dp"
        android:layout_height="56dp"

        android:layout_gravity="center_vertical"

        android:padding="14dp"

        android:background="@drawable/bg_power_button"
        android:contentDescription="Power"

        android:src="@drawable/ic_power" />

</LinearLayout>