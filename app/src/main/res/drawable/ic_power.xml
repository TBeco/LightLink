<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="30dp"
    android:height="30dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!--
        기존 전원 아이콘 모양은 유지하면서
        중심(12, 12)을 기준으로 약 20% 확대한다.
    -->
    <group
        android:pivotX="12"
        android:pivotY="12"
        android:scaleX="1.2"
        android:scaleY="1.2">

        <!-- 위쪽 전원 막대 -->
        <path
            android:pathData="M12,3 L12,11"
            android:fillColor="@android:color/transparent"
            android:strokeColor="#000000"
            android:strokeWidth="2.5"
            android:strokeLineCap="round" />

        <!-- 바깥쪽 전원 원 -->
        <path
            android:pathData="M7.05,5.05 A8,8 0,1 0,16.95,5.05"
            android:fillColor="@android:color/transparent"
            android:strokeColor="#000000"
            android:strokeWidth="2.5"
            android:strokeLineCap="round" />

    </group>

</vector>